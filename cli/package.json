{
  "name": "pixelclaw",
  "version": "0.3.0",
  "type": "module",
  "description": "A pixel art editor for AI agents: indexed-colour art drawn by command through an MCP server and a CLI, with a live browser view where people watch and edit.",
  "license": "MIT",
  "keywords": [
    "pixel-art",
    "pixel",
    "sprite",
    "tileset",
    "autotile",
    "indexed-color",
    "palette",
    "game-art",
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "ai-agent",
    "cli"
  ],
  "homepage": "https://github.com/retrodigio/pixelclaw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retrodigio/pixelclaw.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/retrodigio/pixelclaw/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "pixelclaw": "dist/pixelclaw.js"
  },
  "files": [
    "dist/pixelclaw.js",
    "dist/ui/",
    "dist/skill/",
    "dist/LICENSE",
    "dist/THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "prepack": "node -e \"require('node:fs').accessSync('dist/pixelclaw.js')\" || (echo 'run pnpm build at the repo root first' && exit 1)"
  },
  "devDependencies": {
    "@pixelclaw/core": "workspace:*",
    "@pixelclaw/server": "workspace:*"
  }
}
