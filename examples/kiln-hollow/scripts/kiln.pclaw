  ..33333333333333333333..
  ..33333333333333333333..
  ..33333333333333333333..
  ..33333333333333333333..
  ..33333333333333333333..
>>
paint 7,5 <<
  4444444444
  4444444444
>>
shade ramp=clay edge=2
line 8,7 15,7 c=clay1
# Brick courses on the belly: short, staggered mortar dashes.
line 4,24 6,24 c=clay1
line 11,24 13,24 c=clay1
line 3,29 5,29 c=clay1
line 9,29 11,29 c=clay1
line 15,29 17,29 c=clay1
line 6,34 8,34 c=clay1
line 13,34 15,34 c=clay1
line 4,39 5,39 c=clay1
line 17,39 19,39 c=clay1
# The fire-mouth: an arch with the fire inside, brightest at the floor.
paint 8,39 <<
  ..0000..
  .011110.
  01tttt10
  01tuut10
  01uvvu10
  01uvvu10
  01uvvu10
  01uuuu10
>>
outline
footprint 1x1 at=0,1 anchor=0,0 <<
  r
