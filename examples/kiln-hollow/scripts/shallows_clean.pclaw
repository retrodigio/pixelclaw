px 1,14 16,15 18,16 16,17 22,17 22,19 c=stream1
px 12,7 12,23 13,13 14,0 14,13 15,0 15,13 15,22 16,0 16,21 16,23 17,2 17,22 c=stream1
px 6,8 4,9 8,9 c=stream1
px 7,5 7,10 7,13 8,11 8,13 8,15 c=stream1
px 21,0 23,0 18,1 18,2 21,2 c=stream1
