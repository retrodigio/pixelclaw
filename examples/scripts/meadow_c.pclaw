# A second variant of the meadow: grass_c inside, tufts in other places.
fork meadow meadow_c
variant of=meadow
family texture inside from=grass_c
family band 2:outside 1:moss1 radius=3
px @cell(ew) 8,1 9,1 17,1 3,22 12,22 21,22 c=moss2
px @cell(ew) 8,0 17,0 3,23 21,23 c=moss1
px @cell(ns) 1,2 1,11 1,12 22,20 22,9 c=moss2
px @cell(ns) 0,11 23,20 23,9 c=moss1
px @cell(o) 3,5 6,18 18,3 20,17 c=moss2
