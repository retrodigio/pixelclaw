# Mossy ruins: a coastal village (plan §10 G8), a 40x30 map of 24 px cells built from the G7 shore
# and the meadow and lane families: the sea all round, a beach, a meadow, two lanes crossing, four
# houses, a well at the crossroads and trees; glints on the water.
new map village 40x30 tile=24 palette=ruins-shore
layer add land terrain=shore outside=on above=floor
layer add meadow terrain=meadow above=land
layer add lanes terrain=lane above=meadow
layer add glints overlay=glint on=land:out above=lanes
layer add props objects above=glints

# --- the land: an island with a meadow two cells in from the beach and lanes crossing it
map gen village seed=8

# --- four houses facing the lanes, the well at the crossroads
place house 15,16 layer=props
place house 22,16 layer=props
place house 15,10 layer=props
place house 23,21 layer=props
place well 20,15 layer=props

# --- trees on the meadow, off the lanes, apart from each other and the houses
scatter tree count=22 on=meadow off=lanes minDist=2 layer=props seed=31
